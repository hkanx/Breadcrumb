{
  "manifest_version": 3,
  "name": "Breadcrumb",
  "version": "0.1.0",
  "description": "A Chrome extension scaffold for Breadcrumb.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://github.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "Breadcrumb",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "19": "assets/icon-19.png",
      "32": "assets/icon-32.png",
      "38": "assets/icon-38.png"
    }
  },
  "side_panel": {
    "default_path": "options.html"
  },
  "commands": {
    "trigger-action": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Trigger Breadcrumb action"
    }
  },
  "options_page": "options.html"
}
